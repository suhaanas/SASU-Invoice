# Copy to .env.local (git-ignored). Never commit real values.
#
# Quickest path: put only SUPABASE_ACCESS_TOKEN in .env.local and run
#   scripts/setup-supabase.sh
# It creates the project and fills in everything below for you.
SUPABASE_ACCESS_TOKEN=

# --- Browser (public by design; RLS is what protects data) -------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=
# Paddle client-side token (Developer tools → Authentication) and environment.
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENV=sandbox

# --- Server-side only: NEVER prefix these with VITE_ --------------------------
# Used by deploy scripts and the remote database tests, not by the browser.
SUPABASE_PROJECT_REF=
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=

# Edge Function secrets are set in Supabase (`supabase secrets set NAME=value`), not here:
#   ALLOWED_ORIGINS       https://sasuinvoice.netlify.app,http://localhost:5173
#   APP_URL               https://sasuinvoice.netlify.app   (used for client links in emails)
#   RESEND_API_KEY        from resend.com (domain verified with SPF + DKIM)
#   EMAIL_FROM_ADDRESS    e.g. invoices@mail.yourdomain.com (on the verified domain)
#   RESEND_WEBHOOK_SECRET whsec_… from the Resend webhook settings
#   WORKER_SECRET         openssl rand -hex 32 (also stored in Vault, see supabase/setup)
#   OPENAI_API_KEY        for the AI assistant (optional)
#   OPENAI_MODEL          a current model with structured outputs (default gpt-4.1-mini)
#   PADDLE_API_KEY        Paddle API key (server-side)
#   PADDLE_ENVIRONMENT    sandbox | live
#   PADDLE_WEBHOOK_SECRET the notification destination's secret key
